{
  "name": "shepherd-claude-swap",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && eslint . && prettier --check . && bun test && fallow audit --base origin/main",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/bun": "latest",
    "eslint": "^10.6.0",
    "fallow": "^2.103.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
